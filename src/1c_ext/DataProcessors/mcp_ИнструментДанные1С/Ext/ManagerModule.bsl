#Область ПубличныйИнтерфейс

Процедура ДобавитьИнструменты(Инструменты) Экспорт

	Зарегистрировать(Инструменты, "onec_find_objects",
		"Поиск элементов справочника или документов по точным значениям полей.",
		mcp_Метаданные.ПараметрИнструмента("metaType", "string", "Catalogs или Documents", , Истина, "Catalogs,Documents"),
		mcp_Метаданные.ПараметрИнструмента("name", "string", "Имя объекта метаданных", , Истина),
		mcp_Метаданные.ПараметрИнструмента("filters", "object", "Точные фильтры поле=значение"),
		mcp_Метаданные.ПараметрИнструментаМассив("fields", "string", "Поля для возврата"),
		mcp_Метаданные.ПараметрИнструмента("maxItems", "number", "Максимум строк 1..1000", 100));

	Зарегистрировать(Инструменты, "onec_read_object",
		"Чтение справочника или документа по UUID, включая табличные части.",
		mcp_Метаданные.ПараметрИнструмента("metaType", "string", "Catalogs или Documents", , Истина, "Catalogs,Documents"),
		mcp_Метаданные.ПараметрИнструмента("name", "string", "Имя объекта метаданных", , Истина),
		mcp_Метаданные.ПараметрИнструмента("uuid", "string", "UUID ссылки", , Истина),
		mcp_Метаданные.ПараметрИнструментаМассив("fields", "string", "Поля шапки; пусто = все"),
		mcp_Метаданные.ПараметрИнструмента("includeTabularSections", "boolean", "Читать табличные части", Ложь),
		mcp_Метаданные.ПараметрИнструментаМассив("tabularSections", "string", "Имена ТЧ; пусто = все"),
		mcp_Метаданные.ПараметрИнструмента("maxRowsPerSection", "number", "Максимум строк каждой ТЧ", 1000));

	Зарегистрировать(Инструменты, "onec_write_object",
		"Создание или изменение справочника/документа. Изменение проведенного документа обычной записью запрещено.",
		mcp_Метаданные.ПараметрИнструмента("metaType", "string", "Catalogs или Documents", , Истина, "Catalogs,Documents"),
		mcp_Метаданные.ПараметрИнструмента("name", "string", "Имя объекта метаданных", , Истина),
		mcp_Метаданные.ПараметрИнструмента("uuid", "string", "UUID существующего объекта; пусто = создать"),
		mcp_Метаданные.ПараметрИнструмента("fields", "object", "Поля шапки"),
		mcp_Метаданные.ПараметрИнструмента("tabularSections", "object", "ТЧ: имя -> массив строк"),
		mcp_Метаданные.ПараметрИнструмента("replaceTabularSections", "boolean", "Очищать ТЧ перед заполнением", Истина),
		mcp_Метаданные.ПараметрИнструмента("writeMode", "string", "save/post/unpost", "save", Ложь, "save,post,unpost"),
		mcp_Метаданные.ПараметрИнструмента("postingMode", "string", "operational/nonoperational", "nonoperational", Ложь, "operational,nonoperational"));

	Зарегистрировать(Инструменты, "onec_delete_mark",
		"Штатно установить или снять пометку удаления.",
		mcp_Метаданные.ПараметрИнструмента("metaType", "string", "Catalogs или Documents", , Истина, "Catalogs,Documents"),
		mcp_Метаданные.ПараметрИнструмента("name", "string", "Имя объекта", , Истина),
		mcp_Метаданные.ПараметрИнструмента("uuid", "string", "UUID", , Истина),
		mcp_Метаданные.ПараметрИнструмента("mark", "boolean", "Истина = установить", Истина));

	Зарегистрировать(Инструменты, "onec_post_document",
		"Штатно провести документ.",
		mcp_Метаданные.ПараметрИнструмента("name", "string", "Имя документа", , Истина),
		mcp_Метаданные.ПараметрИнструмента("uuid", "string", "UUID документа", , Истина),
		mcp_Метаданные.ПараметрИнструмента("postingMode", "string", "operational/nonoperational", "nonoperational", Ложь, "operational,nonoperational"));

	Зарегистрировать(Инструменты, "onec_unpost_document",
		"Штатно отменить проведение документа.",
		mcp_Метаданные.ПараметрИнструмента("name", "string", "Имя документа", , Истина),
		mcp_Метаданные.ПараметрИнструмента("uuid", "string", "UUID документа", , Истина));

	Зарегистрировать(Инструменты, "onec_create_on_basis",
		"Создать документ штатным Заполнить(Основание), затем применить только явные переопределения.",
		mcp_Метаданные.ПараметрИнструмента("targetDocument", "string", "Имя создаваемого документа", , Истина),
		mcp_Метаданные.ПараметрИнструмента("basisMetaType", "string", "Catalogs или Documents", , Истина, "Catalogs,Documents"),
		mcp_Метаданные.ПараметрИнструмента("basisName", "string", "Имя основания", , Истина),
		mcp_Метаданные.ПараметрИнструмента("basisUuid", "string", "UUID основания", , Истина),
		mcp_Метаданные.ПараметрИнструмента("fields", "object", "Переопределения шапки"),
		mcp_Метаданные.ПараметрИнструмента("tabularSections", "object", "Переопределения ТЧ"),
		mcp_Метаданные.ПараметрИнструмента("replaceTabularSections", "boolean", "Очищать переопределяемые ТЧ", Истина),
		mcp_Метаданные.ПараметрИнструмента("writeMode", "string", "save/post", "save", Ложь, "save,post"),
		mcp_Метаданные.ПараметрИнструмента("postingMode", "string", "operational/nonoperational", "nonoperational", Ложь, "operational,nonoperational"));

	Зарегистрировать(Инструменты, "onec_fill_on_basis",
		"Штатно перезаполнить существующий документ по основанию; для проведенного нужен repost=true.",
		mcp_Метаданные.ПараметрИнструмента("documentName", "string", "Имя документа", , Истина),
		mcp_Метаданные.ПараметрИнструмента("documentUuid", "string", "UUID документа", , Истина),
		mcp_Метаданные.ПараметрИнструмента("basisMetaType", "string", "Catalogs или Documents", , Истина, "Catalogs,Documents"),
		mcp_Метаданные.ПараметрИнструмента("basisName", "string", "Имя основания", , Истина),
		mcp_Метаданные.ПараметрИнструмента("basisUuid", "string", "UUID основания", , Истина),
		mcp_Метаданные.ПараметрИнструмента("fields", "object", "Переопределения шапки"),
		mcp_Метаданные.ПараметрИнструмента("tabularSections", "object", "Переопределения ТЧ"),
		mcp_Метаданные.ПараметрИнструмента("replaceTabularSections", "boolean", "Очищать переопределяемые ТЧ", Истина),
		mcp_Метаданные.ПараметрИнструмента("repost", "boolean", "Распровести, изменить и снова провести", Ложь),
		mcp_Метаданные.ПараметрИнструмента("postingMode", "string", "operational/nonoperational", "nonoperational", Ложь, "operational,nonoperational"));

	Зарегистрировать(Инструменты, "onec_execute_query",
		"Выполнить только читающий запрос 1С, начинающийся с ВЫБРАТЬ.",
		mcp_Метаданные.ПараметрИнструмента("query", "string", "Текст запроса 1С", , Истина),
		mcp_Метаданные.ПараметрИнструмента("parameters", "object", "Параметры запроса"),
		mcp_Метаданные.ПараметрИнструмента("maxRows", "number", "Максимум возвращаемых строк 1..5000", 500));

	Зарегистрировать(Инструменты, "onec_get_document_movements",
		"Прочитать фактические записи всех регистров движений документа.",
		mcp_Метаданные.ПараметрИнструмента("name", "string", "Имя документа", , Истина),
		mcp_Метаданные.ПараметрИнструмента("uuid", "string", "UUID документа", , Истина),
		mcp_Метаданные.ПараметрИнструмента("maxRowsPerRegister", "number", "Максимум строк регистра 1..5000", 1000));

	Зарегистрировать(Инструменты, "onec_read_register",
		"Чтение физической таблицы регистра по точным фильтрам.",
		mcp_Метаданные.ПараметрИнструмента("metaType", "string", "Тип регистра", , Истина, "InformationRegisters,AccumulationRegisters,AccountingRegisters,CalculationRegisters"),
		mcp_Метаданные.ПараметрИнструмента("name", "string", "Имя регистра", , Истина),
		mcp_Метаданные.ПараметрИнструмента("filters", "object", "Точные фильтры"),
		mcp_Метаданные.ПараметрИнструментаМассив("fields", "string", "Поля; пусто = все"),
		mcp_Метаданные.ПараметрИнструмента("maxRows", "number", "Максимум строк 1..5000", 500));

	Зарегистрировать(Инструменты, "onec_batch",
		"Выполнить несколько операций атомарно в одной транзакции. Вложенный batch запрещен.",
		mcp_Метаданные.ПараметрИнструментаМассив("operations", "object", "Элементы {tool:string,args:object}", Истина));

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "onec_find_objects" Тогда
		Возврат НайтиОбъекты(Аргументы);
	ИначеЕсли ИмяИнструмента = "onec_read_object" Тогда
		Возврат ПрочитатьОбъект(Аргументы);
	ИначеЕсли ИмяИнструмента = "onec_write_object" Тогда
		Возврат ЗаписатьОбъект(Аргументы);
	ИначеЕсли ИмяИнструмента = "onec_delete_mark" Тогда
		Возврат ПометитьНаУдаление(Аргументы);
	ИначеЕсли ИмяИнструмента = "onec_post_document" Тогда
		Возврат ПровестиДокумент(Аргументы);
	ИначеЕсли ИмяИнструмента = "onec_unpost_document" Тогда
		Возврат РаспровестиДокумент(Аргументы);
	ИначеЕсли ИмяИнструмента = "onec_create_on_basis" Тогда
		Возврат СоздатьНаОсновании(Аргументы);
	ИначеЕсли ИмяИнструмента = "onec_fill_on_basis" Тогда
		Возврат ЗаполнитьНаОсновании(Аргументы);
	ИначеЕсли ИмяИнструмента = "onec_execute_query" Тогда
		Возврат ВыполнитьЧитающийЗапрос(Аргументы);
	ИначеЕсли ИмяИнструмента = "onec_get_document_movements" Тогда
		Возврат ПолучитьДвиженияДокумента(Аргументы);
	ИначеЕсли ИмяИнструмента = "onec_read_register" Тогда
		Возврат ПрочитатьРегистр(Аргументы);
	ИначеЕсли ИмяИнструмента = "onec_batch" Тогда
		Возврат ВыполнитьПакет(Аргументы);
	КонецЕсли;

	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;

КонецФункции

#КонецОбласти

#Область Регистрация

Процедура Зарегистрировать(Инструменты, Имя, Описание,
	П1 = Неопределено, П2 = Неопределено, П3 = Неопределено, П4 = Неопределено,
	П5 = Неопределено, П6 = Неопределено, П7 = Неопределено, П8 = Неопределено,
	П9 = Неопределено, П10 = Неопределено)

	Параметры = Новый Массив;
	ДобавитьЕслиЗадан(Параметры, П1); ДобавитьЕслиЗадан(Параметры, П2);
	ДобавитьЕслиЗадан(Параметры, П3); ДобавитьЕслиЗадан(Параметры, П4);
	ДобавитьЕслиЗадан(Параметры, П5); ДобавитьЕслиЗадан(Параметры, П6);
	ДобавитьЕслиЗадан(Параметры, П7); ДобавитьЕслиЗадан(Параметры, П8);
	ДобавитьЕслиЗадан(Параметры, П9); ДобавитьЕслиЗадан(Параметры, П10);

	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты, Имя, Описание,
		mcp_Метаданные.СхемаПараметровИнструмента(Параметры));

КонецПроцедуры

Процедура ДобавитьЕслиЗадан(МассивПараметров, Параметр)
	Если Параметр <> Неопределено Тогда
		МассивПараметров.Добавить(Параметр);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Операции

Функция НайтиОбъекты(Аргументы)

	МетаТип = Аргументы.metaType;
	Имя = Аргументы.name;
	МД = ПолучитьМетаданныеОбъекта(МетаТип, Имя);
	Максимум = ОграничитьЧисло(Аргумент(Аргументы, "maxItems", 100), 1, 1000);
	Поля = Аргумент(Аргументы, "fields", Неопределено);
	Фильтры = Аргумент(Аргументы, "filters", Неопределено);

	СписокПолей = Новый Массив;
	СписокПолей.Добавить("Ссылка");
	Если Поля = Неопределено ИЛИ Поля.Количество() = 0 Тогда
		Для Каждого Поле Из ПоляПоУмолчанию(МетаТип) Цикл
			Если СписокПолей.Найти(Поле) = Неопределено Тогда
				СписокПолей.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Поле Из Поля Цикл
			ПроверитьПолеОбъекта(МД, Поле);
			Если СписокПолей.Найти(Поле) = Неопределено Тогда
				СписокПолей.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Выражения = Новый Массив;
	Для Каждого Поле Из СписокПолей Цикл
		Выражения.Добавить("Объект." + Поле + " КАК " + Поле);
	КонецЦикла;

	Запрос = Новый Запрос;
	Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Строка(Максимум) + Символы.ПС
		+ СтрСоединить(Выражения, "," + Символы.ПС) + Символы.ПС
		+ "ИЗ " + ПрефиксТаблицы(МетаТип) + "." + Имя + " КАК Объект";

	Если Фильтры <> Неопределено Тогда
		Условия = Новый Массив;
		Номер = 0;
		Для Каждого Пара Из Фильтры Цикл
			ПроверитьПолеОбъекта(МД, Пара.Ключ);
			Номер = Номер + 1;
			ИмяПараметра = "P" + Строка(Номер);
			Условия.Добавить("Объект." + Пара.Ключ + " = &" + ИмяПараметра);
			Запрос.УстановитьПараметр(ИмяПараметра, ДекодироватьЗначение(Пара.Значение));
		КонецЦикла;
		Если Условия.Количество() > 0 Тогда
			Текст = Текст + Символы.ПС + "ГДЕ " + СтрСоединить(Условия, Символы.ПС + " И ");
		КонецЕсли;
	КонецЕсли;

	Запрос.Текст = Текст;
	Возврат ТаблицаРезультатаЗапроса(Запрос.Выполнить(), Максимум);

КонецФункции

Функция ПрочитатьОбъект(Аргументы)
	Ссылка = ПолучитьСсылку(Аргументы.metaType, Аргументы.name, Аргументы.uuid);
	ПроверитьСсылку(Ссылка);
	Возврат ПредставлениеОбъекта(
		Ссылка.ПолучитьОбъект(),
		Аргумент(Аргументы, "fields", Неопределено),
		Аргумент(Аргументы, "includeTabularSections", Ложь),
		Аргумент(Аргументы, "tabularSections", Неопределено),
		ОграничитьЧисло(Аргумент(Аргументы, "maxRowsPerSection", 1000), 1, 5000));
КонецФункции

Функция ЗаписатьОбъект(Аргументы)

	МетаТип = Аргументы.metaType;
	Имя = Аргументы.name;
	UUID = Аргумент(Аргументы, "uuid", "");
	Режим = НРег(Аргумент(Аргументы, "writeMode", "save"));
	РежимПроведения = НРег(Аргумент(Аргументы, "postingMode", "nonoperational"));

	Если МетаТип = "Catalogs" Тогда
		Если ЗначениеЗаполнено(UUID) Тогда
			Ссылка = ПолучитьСсылку(МетаТип, Имя, UUID); ПроверитьСсылку(Ссылка);
			Объект = Ссылка.ПолучитьОбъект();
		Иначе
			Объект = Справочники[Имя].СоздатьЭлемент();
		КонецЕсли;
	ИначеЕсли МетаТип = "Documents" Тогда
		Если ЗначениеЗаполнено(UUID) Тогда
			Ссылка = ПолучитьСсылку(МетаТип, Имя, UUID); ПроверитьСсылку(Ссылка);
			Объект = Ссылка.ПолучитьОбъект();
		Иначе
			Объект = Документы[Имя].СоздатьДокумент();
		КонецЕсли;
	Иначе
		ВызватьИсключение "onec_write_object поддерживает Catalogs и Documents";
	КонецЕсли;

	Если МетаТип = "Documents" И ЗначениеЗаполнено(UUID)
		И Объект.Проведен И Режим = "save" Тогда
		ВызватьИсключение "Проведенный документ нельзя менять обычной записью. Используйте onec_batch: unpost -> write -> post.";
	КонецЕсли;

	ПрименитьПоля(Объект, Аргумент(Аргументы, "fields", Неопределено));
	ПрименитьТабличныеЧасти(Объект,
		Аргумент(Аргументы, "tabularSections", Неопределено),
		Аргумент(Аргументы, "replaceTabularSections", Истина));

	Если МетаТип = "Catalogs" Тогда
		Если Режим <> "save" Тогда
			ВызватьИсключение "Для справочника разрешен только writeMode=save";
		КонецЕсли;
		Объект.Записать();
	Иначе
		ЗаписатьДокументВРежиме(Объект, Режим, РежимПроведения);
	КонецЕсли;

	Возврат ПредставлениеОбъекта(Объект, Неопределено, Ложь, Неопределено, 0);

КонецФункции

Функция ПометитьНаУдаление(Аргументы)
	Ссылка = ПолучитьСсылку(Аргументы.metaType, Аргументы.name, Аргументы.uuid);
	ПроверитьСсылку(Ссылка);
	Объект = Ссылка.ПолучитьОбъект();
	Объект.УстановитьПометкуУдаления(Аргумент(Аргументы, "mark", Истина));
	Возврат ПредставлениеОбъекта(Объект, Неопределено, Ложь, Неопределено, 0);
КонецФункции

Функция ПровестиДокумент(Аргументы)
	Ссылка = ПолучитьСсылку("Documents", Аргументы.name, Аргументы.uuid); ПроверитьСсылку(Ссылка);
	Документ = Ссылка.ПолучитьОбъект();
	ЗаписатьДокументВРежиме(Документ, "post", НРег(Аргумент(Аргументы, "postingMode", "nonoperational")));
	Возврат ПредставлениеОбъекта(Документ, Неопределено, Ложь, Неопределено, 0);
КонецФункции

Функция РаспровестиДокумент(Аргументы)
	Ссылка = ПолучитьСсылку("Documents", Аргументы.name, Аргументы.uuid); ПроверитьСсылку(Ссылка);
	Документ = Ссылка.ПолучитьОбъект();
	ЗаписатьДокументВРежиме(Документ, "unpost", "nonoperational");
	Возврат ПредставлениеОбъекта(Документ, Неопределено, Ложь, Неопределено, 0);
КонецФункции

Функция СоздатьНаОсновании(Аргументы)
	Основание = ПолучитьСсылку(Аргументы.basisMetaType, Аргументы.basisName, Аргументы.basisUuid);
	ПроверитьСсылку(Основание);
	Документ = Документы[Аргументы.targetDocument].СоздатьДокумент();
	Документ.Заполнить(Основание);
	ПрименитьПоля(Документ, Аргумент(Аргументы, "fields", Неопределено));
	ПрименитьТабличныеЧасти(Документ,
		Аргумент(Аргументы, "tabularSections", Неопределено),
		Аргумент(Аргументы, "replaceTabularSections", Истина));
	ЗаписатьДокументВРежиме(Документ,
		НРег(Аргумент(Аргументы, "writeMode", "save")),
		НРег(Аргумент(Аргументы, "postingMode", "nonoperational")));
	Возврат ПредставлениеОбъекта(Документ, Неопределено, Истина, Неопределено, 5000);
КонецФункции

Функция ЗаполнитьНаОсновании(Аргументы)
	Ссылка = ПолучитьСсылку("Documents", Аргументы.documentName, Аргументы.documentUuid); ПроверитьСсылку(Ссылка);
	Документ = Ссылка.ПолучитьОбъект();
	БылПроведен = Документ.Проведен;
	Если БылПроведен И Не Аргумент(Аргументы, "repost", Ложь) Тогда
		ВызватьИсключение "Документ проведен. Для штатного изменения передайте repost=true.";
	КонецЕсли;
	Если БылПроведен Тогда
		Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	Основание = ПолучитьСсылку(Аргументы.basisMetaType, Аргументы.basisName, Аргументы.basisUuid);
	ПроверитьСсылку(Основание);
	Документ.Заполнить(Основание);
	ПрименитьПоля(Документ, Аргумент(Аргументы, "fields", Неопределено));
	ПрименитьТабличныеЧасти(Документ,
		Аргумент(Аргументы, "tabularSections", Неопределено),
		Аргумент(Аргументы, "replaceTabularSections", Истина));
	Если БылПроведен Тогда
		ЗаписатьДокументВРежиме(Документ, "post", НРег(Аргумент(Аргументы, "postingMode", "nonoperational")));
	Иначе
		Документ.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	Возврат ПредставлениеОбъекта(Документ, Неопределено, Истина, Неопределено, 5000);
КонецФункции

Функция ВыполнитьЧитающийЗапрос(Аргументы)
	Текст = СокрЛП(Аргументы.query);
	Если СтрДлина(Текст) < 7 ИЛИ Лев(ВРег(Текст), 7) <> "ВЫБРАТЬ" Тогда
		ВызватьИсключение "Разрешены только запросы, начинающиеся с ВЫБРАТЬ";
	КонецЕсли;
	Запрос = Новый Запрос(Текст);
	Параметры = Аргумент(Аргументы, "parameters", Неопределено);
	Если Параметры <> Неопределено Тогда
		Для Каждого Пара Из Параметры Цикл
			Запрос.УстановитьПараметр(Пара.Ключ, ДекодироватьЗначение(Пара.Значение));
		КонецЦикла;
	КонецЕсли;
	Возврат ТаблицаРезультатаЗапроса(Запрос.Выполнить(),
		ОграничитьЧисло(Аргумент(Аргументы, "maxRows", 500), 1, 5000));
КонецФункции

Функция ПолучитьДвиженияДокумента(Аргументы)
	Ссылка = ПолучитьСсылку("Documents", Аргументы.name, Аргументы.uuid); ПроверитьСсылку(Ссылка);
	МД = Метаданные.Документы[Аргументы.name];
	Максимум = ОграничитьЧисло(Аргумент(Аргументы, "maxRowsPerRegister", 1000), 1, 5000);
	Результат = Новый Массив;
	Для Каждого РегистрМД Из МД.Движения Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Строка(Максимум) + Символы.ПС
			+ "Движения.*" + Символы.ПС
			+ "ИЗ " + РегистрМД.ПолноеИмя() + " КАК Движения" + Символы.ПС
			+ "ГДЕ Движения.Регистратор = &Регистратор";
		Запрос.УстановитьПараметр("Регистратор", Ссылка);
		Элемент = Новый Структура;
		Элемент.Вставить("register", РегистрМД.ПолноеИмя());
		Элемент.Вставить("rows", ТаблицаРезультатаЗапроса(Запрос.Выполнить(), Максимум));
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПрочитатьРегистр(Аргументы)
	МД = ПолучитьМетаданныеОбъекта(Аргументы.metaType, Аргументы.name);
	Максимум = ОграничитьЧисло(Аргумент(Аргументы, "maxRows", 500), 1, 5000);
	Поля = Аргумент(Аргументы, "fields", Неопределено);
	Если Поля = Неопределено ИЛИ Поля.Количество() = 0 Тогда
		ВыборПолей = "Регистр.*";
	Иначе
		Части = Новый Массив;
		Для Каждого Поле Из Поля Цикл
			ПроверитьПолеРегистра(МД, Поле);
			Части.Добавить("Регистр." + Поле + " КАК " + Поле);
		КонецЦикла;
		ВыборПолей = СтрСоединить(Части, "," + Символы.ПС);
	КонецЕсли;
	Запрос = Новый Запрос;
	Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Строка(Максимум) + Символы.ПС
		+ ВыборПолей + Символы.ПС
		+ "ИЗ " + ПрефиксТаблицы(Аргументы.metaType) + "." + Аргументы.name + " КАК Регистр";
	Фильтры = Аргумент(Аргументы, "filters", Неопределено);
	Если Фильтры <> Неопределено Тогда
		Условия = Новый Массив;
		Номер = 0;
		Для Каждого Пара Из Фильтры Цикл
			ПроверитьПолеРегистра(МД, Пара.Ключ);
			Номер = Номер + 1;
			ИмяПараметра = "P" + Строка(Номер);
			Условия.Добавить("Регистр." + Пара.Ключ + " = &" + ИмяПараметра);
			Запрос.УстановитьПараметр(ИмяПараметра, ДекодироватьЗначение(Пара.Значение));
		КонецЦикла;
		Если Условия.Количество() > 0 Тогда
			Текст = Текст + Символы.ПС + "ГДЕ " + СтрСоединить(Условия, Символы.ПС + " И ");
		КонецЕсли;
	КонецЕсли;
	Запрос.Текст = Текст;
	Возврат ТаблицаРезультатаЗапроса(Запрос.Выполнить(), Максимум);
КонецФункции

Функция ВыполнитьПакет(Аргументы)
	Результаты = Новый Массив;
	Если Аргументы.operations.Количество() = 0 Тогда
		Возврат Результаты;
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Для Каждого Операция Из Аргументы.operations Цикл
			Если Не Операция.Свойство("tool") Тогда
				ВызватьИсключение "Каждая операция должна содержать tool";
			КонецЕсли;
			Если Операция.tool = "onec_batch" Тогда
				ВызватьИсключение "Вложенный onec_batch запрещен";
			КонецЕсли;
			АргументыОперации = Новый Структура;
			Если Операция.Свойство("args") Тогда
				АргументыОперации = Операция.args;
			КонецЕсли;
			Результаты.Добавить(ВыполнитьИнструмент(Операция.tool, АргументыОперации));
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результаты;
КонецФункции

#КонецОбласти

#Область РаботаСОбъектами

Процедура ПрименитьПоля(Объект, Поля)
	Если Поля = Неопределено Тогда Возврат; КонецЕсли;
	МД = Объект.Метаданные();
	Для Каждого Пара Из Поля Цикл
		Если Пара.Ключ = "Ссылка" ИЛИ Пара.Ключ = "Проведен" ИЛИ Пара.Ключ = "ПометкаУдаления" Тогда
			ВызватьИсключение "Поле " + Пара.Ключ + " нельзя устанавливать напрямую";
		КонецЕсли;
		ПроверитьПолеОбъекта(МД, Пара.Ключ);
		Объект[Пара.Ключ] = ДекодироватьЗначение(Пара.Значение);
	КонецЦикла;
КонецПроцедуры

Процедура ПрименитьТабличныеЧасти(Объект, ТабличныеЧасти, Заменять)
	Если ТабличныеЧасти = Неопределено Тогда Возврат; КонецЕсли;
	МД = Объект.Метаданные();
	Для Каждого ПараТЧ Из ТабличныеЧасти Цикл
		ТЧМД = МД.ТабличныеЧасти.Найти(ПараТЧ.Ключ);
		Если ТЧМД = Неопределено Тогда ВызватьИсключение "Табличная часть не найдена: " + ПараТЧ.Ключ; КонецЕсли;
		ТЧ = Объект[ПараТЧ.Ключ];
		Если Заменять Тогда ТЧ.Очистить(); КонецЕсли;
		Для Каждого ДанныеСтроки Из ПараТЧ.Значение Цикл
			СтрокаТЧ = ТЧ.Добавить();
			Для Каждого ПолеСтроки Из ДанныеСтроки Цикл
				Если ТЧМД.Реквизиты.Найти(ПолеСтроки.Ключ) = Неопределено Тогда
					ВызватьИсключение "Реквизит ТЧ не найден: " + ПараТЧ.Ключ + "." + ПолеСтроки.Ключ;
				КонецЕсли;
				СтрокаТЧ[ПолеСтроки.Ключ] = ДекодироватьЗначение(ПолеСтроки.Значение);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьДокументВРежиме(Документ, Режим, РежимПроведения)
	Если Режим = "save" Тогда
		Документ.Записать(РежимЗаписиДокумента.Запись);
	ИначеЕсли Режим = "post" Тогда
		Если РежимПроведения = "operational" Тогда
			Документ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);
		Иначе
			Документ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		КонецЕсли;
	ИначеЕсли Режим = "unpost" Тогда
		Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе
		ВызватьИсключение "Неизвестный writeMode: " + Режим;
	КонецЕсли;
КонецПроцедуры

Функция ПредставлениеОбъекта(Объект, Поля, ВключитьТЧ, ИменаТЧ, МаксСтрокТЧ)
	МД = Объект.Метаданные();
	Результат = Новый Структура;
	Результат.Вставить("meta", МД.ПолноеИмя());
	Результат.Вставить("ref", КодироватьЗначение(Объект.Ссылка));
	ИменаПолей = Новый Массив;
	Если Поля = Неопределено ИЛИ Поля.Количество() = 0 Тогда
		Для Каждого Стандартный Из МД.СтандартныеРеквизиты Цикл ИменаПолей.Добавить(Стандартный.Имя); КонецЦикла;
		Для Каждого Реквизит Из МД.Реквизиты Цикл
			Если ИменаПолей.Найти(Реквизит.Имя) = Неопределено Тогда ИменаПолей.Добавить(Реквизит.Имя); КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Поле Из Поля Цикл ПроверитьПолеОбъекта(МД, Поле); ИменаПолей.Добавить(Поле); КонецЦикла;
	КонецЕсли;
	Данные = Новый Структура;
	Для Каждого Поле Из ИменаПолей Цикл
		Попытка Данные.Вставить(Поле, КодироватьЗначение(Объект[Поле])); Исключение КонецПопытки;
	КонецЦикла;
	Результат.Вставить("fields", Данные);
	Если ВключитьТЧ Тогда
		РезультатТЧ = Новый Структура;
		Для Каждого ТЧМД Из МД.ТабличныеЧасти Цикл
			Если ИменаТЧ <> Неопределено И ИменаТЧ.Количество() > 0 И ИменаТЧ.Найти(ТЧМД.Имя) = Неопределено Тогда Продолжить; КонецЕсли;
			Строки = Новый Массив; Счетчик = 0;
			Для Каждого СтрокаТЧ Из Объект[ТЧМД.Имя] Цикл
				Если Счетчик >= МаксСтрокТЧ Тогда Прервать; КонецЕсли;
				ДанныеСтроки = Новый Структура;
				Для Каждого РеквизитТЧ Из ТЧМД.Реквизиты Цикл
					ДанныеСтроки.Вставить(РеквизитТЧ.Имя, КодироватьЗначение(СтрокаТЧ[РеквизитТЧ.Имя]));
				КонецЦикла;
				Строки.Добавить(ДанныеСтроки); Счетчик = Счетчик + 1;
			КонецЦикла;
			РезультатТЧ.Вставить(ТЧМД.Имя, Строки);
		КонецЦикла;
		Результат.Вставить("tabularSections", РезультатТЧ);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Метаданные

Функция ПолучитьМетаданныеОбъекта(МетаТип, Имя)
	Попытка Коллекция = Метаданные[МетаТип]; Исключение ВызватьИсключение "Неизвестный metaType: " + МетаТип; КонецПопытки;
	МД = Коллекция.Найти(Имя);
	Если МД = Неопределено Тогда ВызватьИсключение "Объект метаданных не найден: " + МетаТип + "." + Имя; КонецЕсли;
	Возврат МД;
КонецФункции

Функция ПрефиксТаблицы(МетаТип)
	Если МетаТип = "Catalogs" Тогда Возврат "Справочник";
	ИначеЕсли МетаТип = "Documents" Тогда Возврат "Документ";
	ИначеЕсли МетаТип = "InformationRegisters" Тогда Возврат "РегистрСведений";
	ИначеЕсли МетаТип = "AccumulationRegisters" Тогда Возврат "РегистрНакопления";
	ИначеЕсли МетаТип = "AccountingRegisters" Тогда Возврат "РегистрБухгалтерии";
	ИначеЕсли МетаТип = "CalculationRegisters" Тогда Возврат "РегистрРасчета";
	КонецЕсли;
	ВызватьИсключение "Неподдерживаемый metaType: " + МетаТип;
КонецФункции

Функция ПоляПоУмолчанию(МетаТип)
	Результат = Новый Массив; Результат.Добавить("Ссылка");
	Если МетаТип = "Catalogs" Тогда
		Результат.Добавить("Код"); Результат.Добавить("Наименование"); Результат.Добавить("ПометкаУдаления");
	Иначе
		Результат.Добавить("Номер"); Результат.Добавить("Дата"); Результат.Добавить("Проведен"); Результат.Добавить("ПометкаУдаления");
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ПроверитьПолеОбъекта(МД, ИмяПоля)
	Если МД.Реквизиты.Найти(ИмяПоля) <> Неопределено Тогда Возврат; КонецЕсли;
	Для Каждого Стандартный Из МД.СтандартныеРеквизиты Цикл Если Стандартный.Имя = ИмяПоля Тогда Возврат; КонецЕсли; КонецЦикла;
	ВызватьИсключение "Поле объекта не найдено: " + МД.ПолноеИмя() + "." + ИмяПоля;
КонецПроцедуры

Процедура ПроверитьПолеРегистра(МД, ИмяПоля)
	Если МД.Измерения.Найти(ИмяПоля) <> Неопределено ИЛИ МД.Ресурсы.Найти(ИмяПоля) <> Неопределено ИЛИ МД.Реквизиты.Найти(ИмяПоля) <> Неопределено Тогда Возврат; КонецЕсли;
	Для Каждого Стандартный Из МД.СтандартныеРеквизиты Цикл Если Стандартный.Имя = ИмяПоля Тогда Возврат; КонецЕсли; КонецЦикла;
	ВызватьИсключение "Поле регистра не найдено: " + МД.ПолноеИмя() + "." + ИмяПоля;
КонецПроцедуры

#КонецОбласти

#Область Типы

Функция ПолучитьСсылку(МетаТип, Имя, UUID)
	Идентификатор = Новый УникальныйИдентификатор(UUID);
	Если МетаТип = "Catalogs" Тогда Возврат Справочники[Имя].ПолучитьСсылку(Идентификатор);
	ИначеЕсли МетаТип = "Documents" Тогда Возврат Документы[Имя].ПолучитьСсылку(Идентификатор);
	КонецЕсли;
	ВызватьИсключение "Ссылки поддерживаются только для Catalogs и Documents";
КонецФункции

Процедура ПроверитьСсылку(Ссылка)
	Если Ссылка.Пустая() Тогда ВызватьИсключение "Получена пустая ссылка"; КонецЕсли;
КонецПроцедуры

Функция ДекодироватьЗначение(Значение)
	Если Значение = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл Результат.Добавить(ДекодироватьЗначение(Элемент)); КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Если Значение.Свойство("$type") Тогда
			Если Значение["$type"] = "ref" Тогда Возврат ПолучитьСсылку(Значение.metaType, Значение.name, Значение.uuid);
			ИначеЕсли Значение["$type"] = "enum" Тогда Возврат Перечисления[Значение.name][Значение.value];
			ИначеЕсли Значение["$type"] = "date" Тогда Возврат XMLЗначение(Тип("Дата"), Значение.value);
			ИначеЕсли Значение["$type"] = "uuid" Тогда Возврат Новый УникальныйИдентификатор(Значение.value);
			КонецЕсли;
		КонецЕсли;
		Результат = Новый Структура;
		Для Каждого Пара Из Значение Цикл Результат.Вставить(Пара.Ключ, ДекодироватьЗначение(Пара.Значение)); КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция КодироватьЗначение(Значение)
	Если Значение = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево") Тогда Возврат Значение; КонецЕсли;
	Если ТипЗначения = Тип("Дата") Тогда Результат = Новый Структура; Результат.Вставить("$type", "date"); Результат.Вставить("value", XMLСтрока(Значение)); Возврат Результат; КонецЕсли;
	Если ТипЗначения = Тип("УникальныйИдентификатор") Тогда Результат = Новый Структура; Результат.Вставить("$type", "uuid"); Результат.Вставить("value", Строка(Значение)); Возврат Результат; КонецЕсли;
	Если ТипЗначения = Тип("Массив") Тогда Результат = Новый Массив; Для Каждого Элемент Из Значение Цикл Результат.Добавить(КодироватьЗначение(Элемент)); КонецЦикла; Возврат Результат; КонецЕсли;
	Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда Результат = Новый Структура; Для Каждого Пара Из Значение Цикл Результат.Вставить(Пара.Ключ, КодироватьЗначение(Пара.Значение)); КонецЦикла; Возврат Результат; КонецЕсли;
	МД = Неопределено;
	Попытка МД = Метаданные.НайтиПоТипу(ТипЗначения); Исключение КонецПопытки;
	Если МД <> Неопределено Тогда
		Если Метаданные.Справочники.Содержит(МД) ИЛИ Метаданные.Документы.Содержит(МД) Тогда
			Результат = Новый Структура; Результат.Вставить("$type", "ref"); Результат.Вставить("fullName", МД.ПолноеИмя());
			Результат.Вставить("metaType", ?(Метаданные.Справочники.Содержит(МД), "Catalogs", "Documents")); Результат.Вставить("name", МД.Имя);
			Результат.Вставить("uuid", Строка(Значение.УникальныйИдентификатор())); Результат.Вставить("presentation", Строка(Значение)); Возврат Результат;
		ИначеЕсли Метаданные.Перечисления.Содержит(МД) Тогда
			Результат = Новый Структура; Результат.Вставить("$type", "enum"); Результат.Вставить("name", МД.Имя);
			Результат.Вставить("value", ИмяЗначенияПеречисления(МД, Значение)); Результат.Вставить("presentation", Строка(Значение)); Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	Результат = Новый Структура; Результат.Вставить("$type", "value"); Результат.Вставить("typeName", Строка(ТипЗначения)); Результат.Вставить("presentation", Строка(Значение)); Возврат Результат;
КонецФункции

Функция ИмяЗначенияПеречисления(МД, Значение)
	Для Каждого ЗначениеМД Из МД.ЗначенияПеречисления Цикл
		Если Перечисления[МД.Имя][ЗначениеМД.Имя] = Значение Тогда Возврат ЗначениеМД.Имя; КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

#КонецОбласти

#Область ЗапросыИОбщее

Функция ТаблицаРезультатаЗапроса(РезультатЗапроса, Максимум)
	Результат = Новый Массив; Выборка = РезультатЗапроса.Выбрать(); Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Если Счетчик >= Максимум Тогда Прервать; КонецЕсли;
		СтрокаРезультата = Новый Структура;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл СтрокаРезультата.Вставить(Колонка.Имя, КодироватьЗначение(Выборка[Колонка.Имя])); КонецЦикла;
		Результат.Добавить(СтрокаРезультата); Счетчик = Счетчик + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Аргумент(Аргументы, Имя, ЗначениеПоУмолчанию)
	Если Аргументы.Свойство(Имя) Тогда Возврат Аргументы[Имя]; КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция ОграничитьЧисло(Значение, Минимум, Максимум)
	ЧислоЗначение = Цел(Значение);
	Если ЧислоЗначение < Минимум Тогда Возврат Минимум; ИначеЕсли ЧислоЗначение > Максимум Тогда Возврат Максимум; КонецЕсли;
	Возврат ЧислоЗначение;
КонецФункции

#КонецОбласти
